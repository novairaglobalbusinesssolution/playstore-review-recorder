{
  "name": "playstore-review-recorder",
  "version": "2.0.0",
  "description": "Cloud-native automated Play Store review recorder for Render: records HD videos and uploads directly to Google Drive",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "record": "node src/cloudReviewRecorder.js",
    "record:device": "node src/scraper.js",
    "test": "node -e \"require('./src/cloudReviewRecorder'); console.log('Cloud recorder syntax valid.');\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-play-scraper": "^10.1.4",
    "googleapis": "^140.0.0",
    "puppeteer": "^19.0.0",
    "puppeteer-screen-recorder": "^2.1.2",
    "webdriverio": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
